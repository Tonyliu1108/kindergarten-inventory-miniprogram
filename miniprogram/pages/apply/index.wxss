.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 80rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f6f7f9;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.submit-btn {
  background: #2f7dff;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.submit-btn[disabled] {
  background: #9bbcff;
  color: #fff;
}