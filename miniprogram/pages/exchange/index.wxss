.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #222;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.card,
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.item-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.label {
  color: #888;
}

.value {
  color: #333;
}

.stock {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a9b5c;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.input,
.picker,
.textarea {
  background: #f6f7f9;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.input,
.picker {
  height: 96rpx;
  line-height: 56rpx;
}

.disabled {
  color: #999;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
}

.submit-area {
  margin-top: 36rpx;
}

.submit-btn {
  background: #f39c12;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn[disabled] {
  background: #f5c982;
  color: #fff;
}

.loading {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
  font-size: 28rpx;
}