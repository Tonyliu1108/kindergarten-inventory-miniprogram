.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #222;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.card,
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.item-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.label {
  color: #888;
}

.value {
  color: #333;
}

.stock {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a9b5c;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.required-star {
  color: #e54848;
}

.input,
.picker,
.textarea {
  background: #f6f7f9;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.input,
.picker {
  height: 96rpx;
  line-height: 56rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
}

.receipt-tip {
  margin-bottom: 16rpx;
  color: #888;
  font-size: 24rpx;
}

.receipt-upload-btn,
.receipt-remove {
  margin: 0;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.receipt-upload-btn {
  background: #f0f7ff;
  color: #2f7dff;
  border: 2rpx dashed #9bbcff;
}

.receipt-upload-btn::after,
.receipt-remove::after {
  border: none;
}

.receipt-preview {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #f6f7f9;
  border-radius: 14rpx;
  padding: 16rpx;
}

.receipt-image {
  width: 136rpx;
  height: 136rpx;
  border-radius: 10rpx;
  background: #e8ebf0;
  flex-shrink: 0;
}

.receipt-status {
  flex: 1;
  color: #1a9b5c;
  font-size: 26rpx;
}

.receipt-remove {
  width: 160rpx;
  line-height: 64rpx;
  background: #fff;
  color: #e54848;
}

.submit-area {
  margin-top: 36rpx;
}

.submit-btn {
  background: #2f7dff;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn[disabled] {
  background: #9bbcff;
  color: #fff;
}

.loading {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
  font-size: 28rpx;
}
