<view class="page">
  <view class="header">
    <view class="title">出库登记</view>
    <view class="subtitle">请选择出库数量、原因并提交</view>
  </view>

  <view wx:if="{{sku}}" class="card">
    <view class="item-name">{{sku.itemName}}</view>

    <view class="info-row">
      <text class="label">分类</text>
      <text class="value">{{sku.category}}</text>
    </view>

    <view class="info-row">
      <text class="label">尺码</text>
      <text class="value">{{sku.size}}</text>
    </view>

    <view class="info-row">
      <text class="label">当前库存</text>
      <text class="stock">{{sku.stock}}{{sku.unit}}</text>
    </view>

    <view class="info-row">
      <text class="label">位置</text>
      <text class="value">{{sku.location}}</text>
    </view>
  </view>

  <view wx:if="{{sku}}" class="form-card">
    <view class="form-item">
      <view class="form-label">出库数量</view>
      <input
        class="input"
        type="number"
        value="{{quantity}}"
        placeholder="请输入出库数量，必须为整数"
        maxlength="5"
        bindinput="onQuantityInput"
/>
    </view>

    <view class="form-item">
      <view class="form-label">出库原因</view>
      <picker
        mode="selector"
        range="{{reasonList}}"
        value="{{reasonIndex}}"
        bindchange="onReasonChange"
      >
        <view class="picker">
          {{reasonList[reasonIndex]}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">备注</view>
      <textarea
        class="textarea"
        value="{{remark}}"
        placeholder="例如：小一班备用 / 某老师领取 / 换码出库"
        bindinput="onRemarkInput"
      />
    </view>
  </view>

  <view wx:if="{{sku}}" class="submit-area">
    <button
      class="submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submitOutbound"
    >
      确认出库
    </button>
  </view>

  <view wx:else class="loading">
    正在加载库存信息...
  </view>
</view>