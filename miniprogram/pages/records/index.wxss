.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #222;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.filter-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.search-box {
  display: flex;
  align-items: center;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear {
  font-size: 26rpx;
  color: #2f7dff;
  margin-left: 20rpx;
}

.picker {
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.loading,
.empty {
  text-align: center;
  color: #999;
  margin-top: 80rpx;
  font-size: 28rpx;
}

.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  max-width: 500rpx;
}

.type-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.type-tag.in {
  color: #2f7dff;
  background: #eef5ff;
}

.type-tag.add {
  color: #1a9b5c;
  background: #eaf8f1;
}

.type-tag.out {
  color: #e64340;
  background: #fff0f0;
}

.type-tag.exchange {
  color: #f39c12;
  background: #fff5e6;
}

.type-tag.adjust {
  color: #666;
  background: #f1f2f4;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.label {
  color: #888;
  flex-shrink: 0;
}

.value {
  color: #333;
  text-align: right;
  max-width: 480rpx;
}

.strong {
  font-weight: 700;
  color: #1a9b5c;
}

.remark {
  color: #555;
}

.stock-change {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #f6f7f9;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #555;
}

.time {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: right;
}

.date-filter {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.date-item {
  padding: 14rpx 24rpx;
  background: #fff;
  color: #666;
  border-radius: 999rpx;
  font-size: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

.date-item.active {
  background: #2f7dff;
  color: #fff;
  font-weight: 600;
}

.custom-date-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.date-picker {
  min-width: 210rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f1f4f8;
  color: #333;
  font-size: 26rpx;
  line-height: 60rpx;
  text-align: center;
  box-sizing: border-box;
}

.date-separator {
  color: #999;
  font-size: 24rpx;
}

.export-btn {
  margin-top: 22rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: #1a9b5c;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.export-btn::after {
  border: none;
}

.add-change {
  color: #1a9b5c;
  background: #eaf8f1;
}
