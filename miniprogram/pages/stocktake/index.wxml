<view class="page">
  <view class="header">
    <view class="title">库存盘点</view>
    <view class="subtitle">输入实际库存，系统会自动生成盘点调整记录</view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    正在加载物品...
  </view>

  <view wx:elif="{{sku}}" class="content">
    <view class="sku-card">
      <view class="item-name">{{sku.itemName}}</view>

      <view class="info-row">
        <text class="label">分类</text>
        <text class="value">{{sku.category}}</text>
      </view>

      <view class="info-row">
        <text class="label">尺码</text>
        <text class="value">{{sku.size}}</text>
      </view>

      <view class="info-row">
        <text class="label">系统库存</text>
        <text class="stock">{{sku.stock}}{{sku.unit}}</text>
      </view>

      <view class="info-row">
        <text class="label">位置</text>
        <text class="value">{{sku.location}}</text>
      </view>
    </view>

    <view class="form-card">
      <view class="form-item">
        <view class="form-label">实际盘点库存</view>
        <input
          class="input"
          type="number"
          maxlength="5"
          placeholder="请输入实际库存"
          value="{{actualStock}}"
          bindinput="onActualStockInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">盘点原因</view>
        <picker
          mode="selector"
          range="{{reasonList}}"
          value="{{reasonIndex}}"
          bindchange="onReasonChange"
        >
          <view class="picker">
            {{reasonList[reasonIndex]}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <view class="form-label">备注</view>
        <textarea
          class="textarea"
          maxlength="100"
          placeholder="例如：月底盘点 / 纸质记录修正 / 实物短少说明"
          value="{{remark}}"
          bindinput="onRemarkInput"
        />
      </view>
    </view>

    <button
      class="submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submitStockAdjust"
    >
      确认盘点
    </button>
  </view>

  <view wx:else class="empty">
    未找到物品
  </view>
</view>