.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #222;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.loading,
.empty {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
  font-size: 28rpx;
}

.sku-card,
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.item-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.label {
  color: #888;
}

.value {
  color: #333;
}

.stock {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a9b5c;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 14rpx;
}

.input,
.picker,
.textarea {
  width: 100%;
  background: #f6f7f9;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input,
.picker {
  height: 88rpx;
  line-height: 48rpx;
}

.textarea {
  min-height: 180rpx;
}

.submit-btn {
  margin-top: 36rpx;
  background: #e64340;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.submit-btn::after {
  border: none;
}