.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #222;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.add-card,
.user-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 24rpx;
}

.list-title {
  margin-top: 36rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input,
.picker,
.textarea {
  width: 100%;
  background: #f6f7f9;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input,
.picker {
  height: 88rpx;
  line-height: 48rpx;
}

.textarea {
  min-height: 130rpx;
}

.add-btn {
  margin-top: 24rpx;
  background: #2f7dff;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.add-btn[disabled] {
  background: #9bbcff;
  color: #fff;
}

.loading,
.empty {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
  font-size: 28rpx;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
}

.openid {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.role-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.role-tag.admin {
  color: #f39c12;
  background: #fff5e6;
}

.role-tag.teacher {
  color: #2f7dff;
  background: #eef5ff;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 28rpx;
}

.label {
  color: #888;
}

.value {
  color: #333;
}

.status.active {
  color: #1a9b5c;
  font-weight: 600;
}

.status.disabled {
  color: #e64340;
  font-weight: 600;
}

.actions {
  margin-top: 26rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.role-btn {
  background: #f39c12;
  color: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
}

.enable-btn {
  background: #1a9b5c;
  color: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
}

.disable-btn {
  background: #e64340;
  color: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
}

.application-section {
  margin-bottom: 32rpx;
}

.application-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #fff5e6;
}

.apply-tag {
  font-size: 24rpx;
  color: #f39c12;
  background: #fff5e6;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.apply-actions {
  margin-top: 26rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.approve-btn {
  background: #1a9b5c;
  color: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
}

.reject-btn {
  background: #e64340;
  color: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
}

.small-loading,
.small-empty {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}